{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote -v)",
      "Bash(git stash list:*)",
      "Bash(npx wrangler --version)",
      "Bash(npx wrangler d1 info:*)",
      "Bash(npx wrangler d1 list)",
      "Bash(npx wrangler d1 time-travel info:*)",
      "Bash(npx wrangler dev --local:*)",
      "Bash(node src/sync-test.mjs)",
      "Bash(node src/variacoes-test.mjs)",
      "Bash(node src/kits-test.mjs)",
      "Bash(node src/kits-test.mjs:*)",
      "Bash(python src/build.py)",
      "Bash(curl -s http://localhost:8787/api/health)",
      "Bash(wc -l:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(sed -n:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git rebase:*)",
      "Bash(git merge:*)",
      "Bash(git revert:*)",
      "Bash(git push:*)",
      "Bash(npx wrangler d1 execute:*)",
      "Bash(npx wrangler d1 export:*)",
      "Bash(npx wrangler d1 create:*)",
      "Bash(npx wrangler d1 migrations:*)",
      "Bash(npm install:*)",
      "Bash(npx skills add:*)",
      "Bash(rm:*)",
      "Edit(api/src/**)",
      "Edit(api/schema.sql)",
      "Edit(api/migracao-*.sql)",
      "Edit(src/dashboard.tpl.html)",
      "Edit(dashboard.html)",
      "Edit(index.html)"
    ],
    "deny": [
      "Read(./api/.dev.vars)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./api/seed.sql)",
      "Read(./backups/**)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc --prune=now:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(npx wrangler versions deploy:*)",
      "Bash(npx wrangler delete:*)",
      "Bash(npx wrangler d1 delete:*)",
      "Bash(npx wrangler d1 time-travel restore:*)",
      "Bash(npx wrangler d1 execute --remote:*)",
      "Bash(npx wrangler secret put:*)",
      "Bash(npx wrangler secret delete:*)",
      "Bash(npx wrangler secret bulk:*)",
      "Bash(wrangler deploy:*)",
      "Bash(wrangler d1 delete:*)",
      "Bash(wrangler d1 time-travel restore:*)",
      "Bash(wrangler d1 execute --remote:*)",
      "Bash(wrangler secret put:*)",
      "Bash(wrangler secret delete:*)",
      "Edit(./api/.dev.vars)",
      "Edit(./.env)",
      "Edit(./api/seed.sql)"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  }
}
